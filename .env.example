# Vercel Marketplace Neon/Postgres connection string.
# The Neon integration can inject DATABASE_URL automatically.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Telegram BotFather token. Never commit the real token to Git.
TELEGRAM_BOT_TOKEN=123456789:replace_with_your_bot_token

# Destination chat, group, or channel ID. The bot must be allowed to post there.
TELEGRAM_CHAT_ID=replace_with_chat_id
